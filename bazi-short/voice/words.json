 "clauses": [
  {
   "beat": "hook",
   "text": "两个人还没见面，",
   "s": 0.25,
   "e": 1.524,
   "segs": 1,
   "chars": 7
  },
  {
   "beat": "hook",
   "text": "婚事就先被八个字否了。",
   "s": 1.684,
   "e": 3.376,
   "segs": 2,
   "chars": 10
  },
  {
   "beat": "setting",
   "text": "清朝，",
   "s": 4.096,
   "e": 4.63,
   "segs": 1,
   "chars": 2
  },
  {
   "beat": "setting",
   "text": "江南小镇。",
   "s": 4.79,
   "e": 5.814,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "setting",
   "text": "媒人揣着一张红纸——",
   "s": 6.234,
   "e": 7.658,
   "segs": 2,
   "chars": 8
  },
  {
   "beat": "setting",
   "text": "庚帖，",
   "s": 7.958,
   "e": 8.437,
   "segs": 1,
   "chars": 2
  },
  {
   "beat": "setting",
   "text": "上面写着姑娘的生辰八字。",
   "s": 8.597,
   "e": 10.373,
   "segs": 1,
   "chars": 11
  },
  {
   "beat": "a1",
   "text": "年、月、日、时，",
   "s": 11.093,
   "e": 12.074,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "a1",
   "text": "各配一个天干、一个地支。",
   "s": 12.234,
   "e": 14.39,
   "segs": 2,
   "chars": 10
  },
  {
   "beat": "a1",
   "text": "四根柱子，",
   "s": 14.81,
   "e": 15.572,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "a1",
   "text": "正好八个字。",
   "s": 15.732,
   "e": 16.672,
   "segs": 1,
   "chars": 5
  },
  {
   "beat": "a2",
   "text": "男方把它供在祖宗牌位前。",
   "s": 17.392,
   "e": 19.396,
   "segs": 2,
   "chars": 11
  },
  {
   "beat": "a2",
   "text": "三五天里家宅平安，",
   "s": 19.816,
   "e": 21.334,
   "segs": 2,
   "chars": 8
  },
  {
   "beat": "a2",
   "text": "亲事才往下走。",
   "s": 21.494,
   "e": 22.74,
   "segs": 2,
   "chars": 6
  },
  {
   "beat": "a3",
   "text": "再请算命先生合婚：",
   "s": 23.46,
   "e": 25.031,
   "segs": 3,
   "chars": 8
  },
  {
   "beat": "a3",
   "text": "既看代表“夫妻宫”的日柱地支，",
   "s": 25.331,
   "e": 27.487,
   "segs": 2,
   "chars": 12
  },
  {
   "beat": "a3",
   "text": "也看两人的属相。",
   "s": 27.647,
   "e": 28.912,
   "segs": 1,
   "chars": 7
  },
  {
   "beat": "snap",
   "text": "先生拨了拨算盘：",
   "s": 29.632,
   "e": 30.958,
   "segs": 2,
   "chars": 7
  },
  {
   "beat": "snap",
   "text": "男属马，",
   "s": 31.258,
   "e": 31.847,
   "segs": 1,
   "chars": 3
  },
  {
   "beat": "snap",
   "text": "女属鼠——",
   "s": 32.007,
   "e": 32.609,
   "segs": 1,
   "chars": 3
  },
  {
   "beat": "snap",
   "text": "子午相冲。",
   "s": 32.909,
   "e": 33.619,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "rhyme",
   "text": "就算躲过相冲，",
   "s": 34.339,
   "e": 35.711,
   "segs": 1,
   "chars": 6
  },
  {
   "beat": "rhyme",
   "text": "民间还有口诀：",
   "s": 35.871,
   "e": 37.047,
   "segs": 1,
   "chars": 6
  },
  {
   "beat": "rhyme",
   "text": "“白马怕青牛，",
   "s": 37.347,
   "e": 38.418,
   "segs": 1,
   "chars": 5
  },
  {
   "beat": "rhyme",
   "text": "羊鼠一旦休。”",
   "s": 38.578,
   "e": 39.614,
   "segs": 1,
   "chars": 5
  },
  {
   "beat": "dead",
   "text": "好消息是，",
   "s": 40.334,
   "e": 41.237,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "dead",
   "text": "每个属相都有一个“六合”的天生搭档。",
   "s": 41.397,
   "e": 43.834,
   "segs": 3,
   "chars": 15
  },
  {
   "beat": "dead",
   "text": "坏消息是，",
   "s": 44.254,
   "e": 45.137,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "dead",
   "text": "每个属相也有一个冲、一个害，",
   "s": 45.297,
   "e": 47.833,
   "segs": 2,
   "chars": 12
  },
  {
   "beat": "dead",
   "text": "还躲不开一个“刑”。",
   "s": 47.993,
   "e": 49.254,
   "segs": 1,
   "chars": 7
  },
  {
   "beat": "explain",
   "text": "合婚就像两只齿轮：",
   "s": 49.974,
   "e": 51.476,
   "segs": 1,
   "chars": 8
  },
  {
   "beat": "explain",
   "text": "齿对上了叫“合”，",
   "s": 51.776,
   "e": 52.996,
   "segs": 2,
   "chars": 6
  },
  {
   "beat": "explain",
   "text": "转得顺；",
   "s": 53.156,
   "e": 53.778,
   "segs": 1,
   "chars": 3
  },
  {
   "beat": "explain",
   "text": "齿顶上了叫“冲”，",
   "s": 54.078,
   "e": 55.395,
   "segs": 1,
   "chars": 6
  },
  {
   "beat": "explain",
   "text": "咔咔响。",
   "s": 55.555,
   "e": 56.218,
   "segs": 1,
   "chars": 3
  },
  {
   "beat": "conseq",
   "text": "从唐宋算起，",
   "s": 56.938,
   "e": 58.168,
   "segs": 1,
   "chars": 5
  },
  {
   "beat": "conseq",
   "text": "“八字合不合”，",
   "s": 58.328,
   "e": 59.232,
   "segs": 2,
   "chars": 5
  },
  {
   "beat": "conseq",
   "text": "在婚前被问了一千多年。",
   "s": 59.392,
   "e": 61.061,
   "segs": 1,
   "chars": 10
  },
  {
   "beat": "twist",
   "text": "所以今天，",
   "s": 61.781,
   "e": 62.685,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "twist",
   "text": "两样东西处不来，",
   "s": 62.845,
   "e": 64.077,
   "segs": 1,
   "chars": 7
  },
  {
   "beat": "twist",
   "text": "我们还会说：",
   "s": 64.237,
   "e": 65.176,
   "segs": 1,
   "chars": 5
  },
  {
   "beat": "twist",
   "text": "八字不合。",
   "s": 65.476,
   "e": 66.204,
   "segs": 1,
   "chars": 4
  },
  {
   "beat": "twist",
   "text": "比如这只猫，",
   "s": 66.624,
   "e": 67.46,
   "segs": 1,
   "chars": 5
  },
  {
   "beat": "twist",
   "text": "和那只碗。",
   "s": 67.62,
   "e": 68.32,
   "segs": 1,
   "chars": 4
  }
 ],
